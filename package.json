{
  "name": "winds-mobi-client-web",
  "version": "0.0.0",
  "private": true,
  "description": "Web client for winds.mobi — real-time weather observations for free-flight pilots",
  "repository": "https://github.com/winds-mobi/winds-mobi-client-web",
  "license": "MIT",
  "author": "",
  "packageManager": "pnpm@10.13.1",
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "scripts": {
    "build": "vite build",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\" --prefixColors auto",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" --prefixColors auto && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:hbs": "ember-template-lint .",
    "lint:hbs:fix": "ember-template-lint . --fix",
    "lint:js": "eslint . --cache",
    "lint:js:fix": "eslint . --fix",
    "lint:types": "ember-tsc --noEmit",
    "start": "vite --host 0.0.0.0",
    "test": "concurrently \"pnpm:lint\" \"pnpm:test:ember\" --names \"lint,test:\" --prefixColors auto",
    "test:ember": "EMBROIDER_WORKING_DIRECTORY=node_modules/.embroider-test vite build --mode test && ember test --path dist",
    "test:ember:dev": "testem ci --file testem-dev.js",
    "test:ember:dev:server": "testem --file testem-dev.js",
    "generate-pwa-assets": "pwa-assets-generator"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/eslint-parser": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.27.1",
    "@babel/plugin-transform-typescript": "^7.28.0",
    "@babel/runtime": "^7.27.1",
    "@ember-intl/vite": "^1.3.0",
    "@ember/app-tsconfig": "^2.0.0",
    "@ember/optional-features": "^3.0.0",
    "@ember/string": "^4.0.1",
    "@ember/test-helpers": "^5.4.3",
    "@ember/test-waiters": "^4.1.2",
    "@embroider/compat": "^4.1.20",
    "@embroider/config-meta-loader": "^1.0.0",
    "@embroider/core": "^4.6.1",
    "@embroider/legacy-inspector-support": "^0.1.3",
    "@embroider/macros": "^1.20.4",
    "@embroider/router": "^3.0.6",
    "@embroider/util": "^1.13.5",
    "@embroider/vite": "^1.7.7",
    "@eslint/js": "^9.23.0",
    "@frontile/buttons": "0.17.1",
    "@frontile/collections": "0.17.1",
    "@frontile/forms": "0.17.1",
    "@frontile/notifications": "0.17.1",
    "@frontile/overlays": "0.17.1",
    "@frontile/theme": "0.17.1",
    "@frontile/utilities": "0.17.1",
    "@glimmer/component": "^2.1.1",
    "@glimmer/tracking": "^1.1.2",
    "@glint/ember-tsc": "1.4.0",
    "@glint/template": "1.7.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/qunit": "^2.19.12",
    "@types/rsvp": "^4.0.9",
    "@vite-pwa/assets-generator": "^1.0.2",
    "babel-plugin-ember-template-compilation": "^4.0.0",
    "concurrently": "^9.1.2",
    "decorator-transforms": "^2.3.2",
    "ember-auto-import": "^2.13.1",
    "ember-cli": "~7.1.0",
    "ember-cli-babel": "^8.3.1",
    "ember-cli-deprecation-workflow": "^4.0.1",
    "ember-cli-htmlbars": "^7.0.1",
    "ember-concurrency": "^5.2.0",
    "ember-intl": "^8.4.0",
    "ember-load-initializers": "^3.0.1",
    "ember-maplibre-gl": "^0.7.0",
    "ember-modifier": "^4.3.0",
    "ember-page-title": "^9.0.3",
    "ember-phosphor-icons": "^1.0.2",
    "ember-qunit": "^9.1.0",
    "ember-resolver": "^13.2.0",
    "ember-simple-auth": "^8.3.1",
    "ember-source": "~7.1.0",
    "ember-template-lint": "^7.9.3",
    "ember-tracked-local-storage": "^2.0.1",
    "ember-truth-helpers": "^5.0.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ember": "^12.7.5",
    "eslint-plugin-n": "^17.16.2",
    "eslint-plugin-qunit": "^8.1.2",
    "globals": "^15.15.0",
    "maplibre-gl": "6.1.0",
    "prettier": "^3.5.3",
    "prettier-plugin-ember-template-tag": "^2.0.4",
    "qunit": "^2.24.1",
    "qunit-dom": "^3.4.0",
    "stylelint": "^17.13.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "testem": "^3.15.2",
    "tracked-built-ins": "^4.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "engines": {
    "node": "24.4.1",
    "pnpm": "10.13.1"
  },
  "pnpm": {
    "overrides": {
      "ember-cli-htmlbars": "^7.0.1"
    }
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "type": "app",
    "version": 2
  },
  "exports": {
    "./tests/*": "./tests/*",
    "./*": "./app/*"
  },
  "dependencies": {
    "@ember-data/debug": "5.8.2",
    "@ember-data/model": "5.8.2",
    "@ember-data/request-utils": "5.8.2",
    "@ember-data/store": "5.8.2",
    "@warp-drive/build-config": "5.8.2",
    "@warp-drive/core": "5.8.2",
    "@warp-drive/core-types": "5.8.2",
    "@warp-drive/ember": "5.8.2",
    "@warp-drive/experiments": "0.2.8",
    "@warp-drive/json-api": "5.8.2",
    "@warp-drive/legacy": "5.8.2",
    "@warp-drive/schema-record": "5.8.2",
    "@warp-drive/utilities": "5.8.2",
    "highcharts": "13.0.0",
    "sharp": "^0.35.3"
  }
}
